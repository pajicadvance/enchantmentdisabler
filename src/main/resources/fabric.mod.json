{
  "schemaVersion": 1,
  "id": "${id}",
  "name": "${name}",
  "version": "${version}",
  "authors": ["${authors}"],
  "contributors": ["${contributors}"],
  "contact": {
    "sources": "${sources_url}",
    "issues": "${issues_url}",
    "homepage": "${homepage_url}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord_url}"
      }
    }
  },
  "description": "${description}",
  "icon": "icon.png",
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "${group}.${id}.platform.fabric.FabricEntrypoint"
    ],
    "emi": [
      "${group}.${id}.plugin.EMIPlugin"
    ],
    "rei_client": [
      "${group}.${id}.plugin.REIPlugin"
    ],
    "jei_mod_plugin": [
      "${group}.${id}.plugin.JEIPlugin"
    ],
    "rrv_client": [
      "${group}.${id}.plugin.RRVPlugin"
    ]
  },
  "mixins": [
    "${id}.mixins.json"
  ],${dependencies}
}

{
  "schemaVersion": 1,
  "id": "enchantmentdisabler",
  "version": "${version}",
  "name": "Enchantment Disabler",
  "description": "Disable enchantments you don't like. Configurable, also works with modded enchantments.",
  "authors": [
    "pajic"
  ],
  "contact": {
    "website": "https://modrinth.com/mod/enchantment-disabler",
    "repo": "https://github.com/pajicadvance/enchantmentdisabler"
  },
  "license": "MIT",
  "icon": "enchantmentdisabler.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.pajic.enchantmentdisabler.Main"
    ]
  },
  "mixins": [
    "enchantmentdisabler.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "owo-lib": "^0.11.2"
  },
  "suggests": {
    "modmenu": "^7.2.2"
